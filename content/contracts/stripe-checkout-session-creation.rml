#lang rmn/v2
(map
  ("type" "StripeCheckoutSessionCreationLaw")
  ("version" 1)
  ("provider" "urn:ame:stripe-payment-acceptance-enterprise")
  ("precondition" "A customer smart-account settlement authorizes one fixed active offering, bounded quantity, safe redirects, and its opaque order reference under this exact law.")
  ("operation" "The provider derives price from its own catalog, creates an idempotent Stripe Checkout Session, and records a redacted receipt through its hired witness-journal RDF provider.")
